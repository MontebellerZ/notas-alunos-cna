generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id     Int     @id @default(autoincrement())
  email  String  @unique
  nome   String?
  turmas Turma[]
  admin  Boolean @default(false)
}

model Turma {
  id         Int          @id @default(autoincrement())
  nome       String
  sala       String?
  situacao   String?
  inicio     String?
  fim        String?
  aulasJson  String       @default("[]") @map("aulas_json")
  alunos     TurmaAluno[]
  atividades Atividade[]
  usuario    Usuario?     @relation(fields: [usuarioId], references: [id])
  usuarioId  Int?
  ativo      Boolean      @default(true)
}

model TurmaAluno {
  turma   Turma   @relation(fields: [turmaId], references: [id])
  turmaId Int
  aluno   Aluno   @relation(fields: [alunoId], references: [id])
  alunoId Int
  ativo   Boolean @default(true)

  @@id([turmaId, alunoId])
}

model Aluno {
  id     Int          @id @default(autoincrement())
  nome   String
  idade  Int?
  turmas TurmaAluno[]
  notas  Nota[]
  ativo  Boolean      @default(true)
}

model Atividade {
  id             Int             @id @default(autoincrement())
  capitulo       String
  peso           Float?
  turma          Turma           @relation(fields: [turmaId], references: [id])
  turmaId        Int
  notas          Nota[]
  atividadeItens AtividadeItem[]
  ativo          Boolean         @default(true)
}

model AtividadeItem {
  id          Int        @id @default(autoincrement())
  nome        String
  peso        Float      @default(1)
  atividade   Atividade  @relation(fields: [atividadeId], references: [id])
  atividadeId Int
  notaItens   NotaItem[]
  ativo       Boolean    @default(true)
}

model Nota {
  id          Int        @id @default(autoincrement())
  valor       Float?
  aluno       Aluno      @relation(fields: [alunoId], references: [id])
  alunoId     Int
  atividade   Atividade  @relation(fields: [atividadeId], references: [id])
  atividadeId Int
  notaItens   NotaItem[]
  ativo       Boolean    @default(true)
}

model NotaItem {
  id              Int           @id @default(autoincrement())
  valor           Float?
  nota            Nota          @relation(fields: [notaId], references: [id])
  notaId          Int
  atividadeItem   AtividadeItem @relation(fields: [atividadeItemId], references: [id])
  atividadeItemId Int
  ativo           Boolean       @default(true)
}
